// Cloudflare Workers config: serves the static site from dist/ and runs the breakfast
// order API at /api/orders. STAFF_PASSWORD is a secret set in the dashboard, never here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oakwellhotel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oakwell-orders",
      // Replace with the id printed by `npx wrangler d1 create oakwell-orders` (see DEPLOY.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Keep variables set in the dashboard when deploying.
  "keep_vars": true
}
