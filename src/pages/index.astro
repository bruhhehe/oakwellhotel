---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import GuestBook from '../components/GuestBook.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import seaside from '../assets/oakwellbackground.png';
import map from '../assets/oakwellmap.png';
import { site, whatsappUrl } from '../data/site';
---
<Base
  title="Oakwell Hotel Blackpool | A Family Seaside Stay"
  description="A family-friendly, alcohol-free hotel facing Blackpool's seafront, close to the beach, arcades, Pleasure Beach and Sandcastle Waterpark."
  page="home"
>
  <main id="main">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <Image
        src={seaside}
        alt=""
        class="hero-art"
        widths={[640, 941]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="wrap hero-copy">
        <h1 id="hero-title">Your Family Stay by the Sea</h1>
        <p class="lede">An alcohol-free family hotel with twelve rooms on South Promenade, facing the sea.</p>
        <div class="actions">
          <a class="btn btn-primary" href={whatsappUrl()} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Book via WhatsApp
          </a>
          <a class="btn btn-ghost" href="#gallery">See inside</a>
        </div>
        <p class="reply">Message us your dates and group size. We usually reply within a few hours.</p>
      </div>
    </section>

    <Gallery />

    <section id="location" class="location" aria-labelledby="location-title">
      <div class="wrap location-grid">
        <div class="location-copy">
          <h2 id="location-title">Blackpool on your doorstep</h2>
          <p>
            We’re on South Promenade, looking straight out to sea. The beach, the arcades, Pleasure
            Beach and Sandcastle Waterpark are all close by.
          </p>
          <address>
            <Icon name="pin" />
            <span>
              Oakwell Hotel<br />{site.address}<br />
              <a class="maps-link" href={site.mapsUrl} target="_blank" rel="noopener">
                Open in Google Maps <Icon name="external" />
              </a>
            </span>
          </address>
        </div>
        <a class="map" href={site.mapsUrl} target="_blank" rel="noopener" aria-label="Open Oakwell Hotel in Google Maps">
          <Image
            src={map}
            alt="Illustrated map of Blackpool seafront showing North, Central and South Pier, Blackpool Tower, Pleasure Beach, Sandcastle Waterpark and Oakwell Hotel on South Promenade"
            widths={[640, 1000, 1428]}
            sizes="(max-width: 60rem) 100vw, 44rem"
          />
        </a>
      </div>
    </section>

    <GuestBook />

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="wrap contact-grid">
        <div>
          <h2 id="contact-title">Message the hosts</h2>
          <p class="lede">Tell us your dates and how many of you are coming. We usually reply within a few hours.</p>
          <div class="contact-actions">
            <a class="btn btn-primary" href={whatsappUrl()} target="_blank" rel="noopener">
              <Icon name="whatsapp" /> Book via WhatsApp
            </a>
            <p>or email <a href={`mailto:${site.email}?subject=${encodeURIComponent('Booking enquiry')}`}>{site.email}</a></p>
          </div>
        </div>
        <aside class="breakfast-note" aria-labelledby="breakfast-title">
          <h3 id="breakfast-title">Breakfast for staying guests</h3>
          <p>£9.49 a plate, served 9:30–11:00. Build your plate from your phone and it goes straight to the kitchen.</p>
          <a href="/breakfast">Order breakfast</a>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: start;
    min-height: max(40rem, 100svh);
    padding-top: clamp(8rem, 5rem + 9vh, 11rem);
    overflow: hidden;
    background: var(--sky);
  }

  /* The painting: sky behind the words, the shore and rides along the bottom edge */
  .hero :global(.hero-art) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  /* Wide screens: the painting is width-bound and bottom-anchored, so the horizon sits about
     34vw above the hero's bottom edge. Padding that band keeps every word over the sky. */
  @media (min-width: 40rem) {
    .hero {
      padding-bottom: calc(34vw + 3rem);
    }
  }

  /* Fade the sand into the cream page below */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 14%;
    z-index: -1;
    background: linear-gradient(to bottom, transparent, var(--cream-50));
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  h1 {
    max-width: 12ch;
    font-size: var(--step-hero);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.028em;
    text-shadow: 0 1px 24px rgb(251 246 238 / 0.55);
  }

  .hero .lede {
    max-width: 44ch;
    text-wrap: balance;
    margin-top: 1.4rem;
    color: var(--ink);
    text-shadow: 0 1px 14px rgb(251 246 238 / 0.9);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .reply {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    text-shadow: 0 1px 12px rgb(251 246 238 / 0.95);
  }

  /* Location */
  .location {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(4rem, 3rem + 5vw, 7rem);
    background: linear-gradient(to bottom, var(--cream-50), var(--foam));
  }

  .location-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .location h2 {
    font-size: var(--step-1);
    max-width: 10ch;
  }

  .location-copy > p {
    margin-top: 1.25rem;
    max-width: 36ch;
    color: var(--ink-soft);
  }

  address {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-style: normal;
    line-height: 1.5;
  }

  address :global(svg) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.1rem;
    color: var(--sea);
  }

  .maps-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-weight: 550;
  }

  .maps-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .map {
    display: block;
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }

  .map:hover {
    transform: translateY(-3px);
  }

  .map :global(img) {
    width: 100%;
    height: auto;
  }

  /* Contact */
  .contact {
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem) clamp(3rem, 2rem + 3vw, 4rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: end;
  }

  .contact h2 {
    font-size: var(--step-1);
    max-width: 11ch;
  }

  .contact .lede {
    margin: 1.25rem 0 2rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .contact-actions p {
    color: var(--ink-soft);
  }

  .breakfast-note {
    justify-self: end;
    padding-top: 1.25rem;
    border-top: 2px solid var(--sand);
    max-width: 30ch;
  }

  .breakfast-note h3 {
    font-size: var(--step-3);
    font-weight: 600;
  }

  .breakfast-note p {
    margin: 0.5rem 0 0.75rem;
    color: var(--ink-soft);
  }

  .breakfast-note a {
    font-weight: 550;
  }

  @media (max-width: 60rem) {
    .breakfast-note {
      justify-self: start;
    }

    .location-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .location h2 {
      max-width: 14ch;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      min-height: max(44rem, 100svh);
      padding-top: 7rem;
    }

    .hero :global(.hero-art) {
      object-position: 42% 100%;
    }

    .actions {
      width: 100%;
      flex-direction: column;
    }

    .actions .btn {
      width: 100%;
    }

  }
</style>
