---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photos } from '../data/gallery';

// Polaroids at one shared height; width follows each photo's shape.
const widths = { portrait: 300, square: 400, landscape: 570 } as const;
---
<section id="gallery" class="gallery" aria-labelledby="gallery-title">
  <div class="wrap section-head">
    <h2 id="gallery-title">Take a Look Around</h2>
    <div class="controls">
      <button class="nav-btn" type="button" data-dir="-1" aria-label="Previous photos" aria-controls="gallery-track">
        <Icon name="arrow-left" />
      </button>
      <button class="nav-btn" type="button" data-dir="1" aria-label="Next photos" aria-controls="gallery-track">
        <Icon name="arrow-right" />
      </button>
    </div>
  </div>

  <ul id="gallery-track" class="track" tabindex="0" aria-label="Photos of the hotel">
    {photos.map((p, i) => (
      <li class="photo" data-shape={p.shape} style={`--tilt: ${[-1.4, 1, -0.6, 1.5, -1.1, 0.7, -1.6, 1.2][i]}deg`}>
        <figure>
          <span class="tape" aria-hidden="true"></span>
          <Image
            src={p.src}
            alt={p.alt}
            widths={[widths[p.shape], widths[p.shape] * 2]}
            sizes={`${widths[p.shape]}px`}
            loading={i < 3 ? 'eager' : 'lazy'}
            style={`object-position: ${p.position}`}
          />
          <figcaption>{p.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<script>
  const track = document.getElementById('gallery-track');
  document.querySelectorAll<HTMLButtonElement>('.gallery .nav-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!track) return;
      const step = Math.max(track.clientWidth * 0.8, 280);
      track.scrollBy({ left: Number(btn.dataset.dir) * step, behavior: 'smooth' });
    });
  });

  const update = () => {
    if (!track) return;
    const max = track.scrollWidth - track.clientWidth - 2;
    const [prev, next] = document.querySelectorAll<HTMLButtonElement>('.gallery .nav-btn');
    prev.disabled = track.scrollLeft <= 2;
    next.disabled = track.scrollLeft >= max;
  };
  track?.addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
</script>

<style>
  .gallery {
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem) clamp(3rem, 2rem + 4vw, 5rem);
    background: var(--cream-50);
  }

  .controls {
    display: flex;
    gap: 0.5rem;
  }

  .nav-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1.5px solid rgb(43 33 24 / 0.2);
    background: var(--cream-50);
    color: var(--ink);
    transition: background-color 0.2s, border-color 0.2s, opacity 0.2s;
  }

  .nav-btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .nav-btn:hover:not(:disabled) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream-50);
  }

  .nav-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (max-width: 40rem) {
    .controls {
      display: none;
    }
  }

  .track {
    --h: clamp(17rem, 12rem + 18vw, 25rem);
    display: flex;
    align-items: flex-start;
    gap: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    margin: 0;
    padding: 1.75rem max(var(--gutter), (100% - var(--wrap)) / 2) 2.5rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), (100% - var(--wrap)) / 2);
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline-offset: -4px;
  }

  .photo {
    flex: none;
    scroll-snap-align: start;
  }

  figure {
    position: relative;
    margin: 0;
    padding: 0.75rem 0.75rem 0;
    background: #fffdf8;
    box-shadow: var(--shadow-soft);
    transform: rotate(var(--tilt));
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }

  .photo:hover figure {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  figure :global(img) {
    width: calc(var(--h) * var(--ratio, 0.75));
    height: var(--h);
    object-fit: cover;
    background: var(--cream-100);
  }

  [data-shape='square'] {
    --ratio: 1;
  }

  [data-shape='landscape'] {
    --ratio: 1.42;
  }

  figcaption {
    width: calc(var(--h) * var(--ratio, 0.75));
    padding: 0.85rem 0.25rem 1.1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  .tape {
    position: absolute;
    top: -0.85rem;
    left: 50%;
    width: 6.5rem;
    height: 1.7rem;
    translate: -50% 0;
    rotate: -2deg;
    background: linear-gradient(100deg, rgb(232 212 168 / 0.85), rgb(216 195 148 / 0.75));
    box-shadow: 0 1px 2px rgb(43 33 24 / 0.08);
    mask: linear-gradient(90deg, transparent 0 3px, #000 3px calc(100% - 3px), transparent 0);
  }

  .photo:nth-child(even) .tape {
    rotate: 3deg;
    left: 42%;
  }

  @media (max-width: 40rem) {
    .track {
      --h: 22rem;
    }

    [data-shape='landscape'] {
      --ratio: 0.95;
    }
  }
</style>
